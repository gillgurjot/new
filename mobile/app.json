{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "1.0.2",
    "scheme": "lumen",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#09090d",
    "ios": {
      "bundleIdentifier": "com.gurjotgill.lumen",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.gurjotgill.lumen",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#09090d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "lumen.local.xgill.com",
              "pathPrefix": "/play/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "GoogleSans",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/GoogleSansFlex_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/GoogleSansFlex_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090d",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "react-native-video",
        {
          "enableNotificationControls": true,
          "enableAndroidPictureInPicture": true,
          "enableBackgroundAudio": true,
          "androidExtensions": {
            "useExoplayerHls": true,
            "useExoplayerDash": false,
            "useExoplayerSmoothStreaming": false,
            "useExoplayerRtsp": false
          }
        }
      ],
      "@kesha-antonov/react-native-background-downloader",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
