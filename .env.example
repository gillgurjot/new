# ---- Required: where Lumen is reachable (used for the OIDC callback) ----
PUBLIC_URL=https://lumen.zenith.example.com

# ---- Required: Pocket ID (OIDC) ----
# In Pocket ID: Administration → OIDC Clients → Add OIDC Client
#   Callback URL:        https://lumen.zenith.example.com/api/auth/callback
#   Logout callback URL: https://lumen.zenith.example.com/login
OIDC_ISSUER=https://id.zenith.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Members of this Pocket ID group are Lumen admins.
OIDC_ADMIN_GROUP=lumen-admins
# Optional: only members of this group (or the admin group) may sign in. Empty = anyone Pocket ID lets through.
OIDC_USER_GROUP=
# OIDC_SCOPES=openid profile email groups
# OIDC_GROUPS_CLAIM=groups

# ---- Recommended: metadata and artwork (free key at https://www.themoviedb.org/settings/api) ----
# Either the v3 API key or the v4 read access token works.
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# ---- Transcoding ----
# auto tries VAAPI, then QSV, then falls back to CPU. Options: auto | vaapi | qsv | none
LUMEN_HWACCEL=auto
LUMEN_VAAPI_DEVICE=/dev/dri/renderD128
LUMEN_MAX_TRANSCODES=4
# Older Intel (Broadwell and earlier) may need: LIBVA_DRIVER_NAME=i965
# AMD normally picks radeonsi automatically.

# ---- Optional ----
# LUMEN_SCAN_INTERVAL=6h
# LUMEN_SESSION_TTL=720h
# LUMEN_TRICKPLAY=true
# LUMEN_LOG_LEVEL=info
# LUMEN_SECRET_KEY=   (auto-generated and stored in the database when empty)

# ---- docker-compose helpers ----
PUID=1000
PGID=1000
RENDER_GID=993
LUMEN_PORT=8096
MEDIA_DIR=/srv/media
